# =====================================================================
# GREEN-FINANCE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and supply your environment-specific secrets.
# NEVER commit real secret keys or production passwords to version control.
# =====================================================================

# Application
APP_NAME=green-finance
ENVIRONMENT=development
PORT=8000

# Database (PostgreSQL recommended for production, SQLite for local demo)
# DATABASE_URL=postgresql://gf_user:secure_password_here@localhost:5432/green_finance
DATABASE_URL=sqlite:///test.db
USE_SQLITE=true

# Redis Cache / Distributed Rate Limiting
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# In production, generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_to_a_long_random_string_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Prometheus / Observability
PROMETHEUS_URL=http://localhost:9090

# One-time Super Admin Bootstrap Secret (used only during initial setup)
BOOTSTRAP_ADMIN_TOKEN=configure_a_one_time_bootstrap_secret_here
